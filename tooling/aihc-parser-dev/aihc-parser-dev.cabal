cabal-version: 3.8
name: aihc-parser-dev
version: 0.1.0.0
build-type: Simple
license: Unlicense
author: David Himmelstrup
maintainer: lemmih@gmail.com
category: Development
synopsis: Development CLI for inspecting aihc-parser syntax trees
description:
  Internal development tool for parsing Haskell source from standard input,
  inspecting its syntax tree, and exercising the pretty-printer.

executable aihc-parser-dev
  main-is: Main.hs
  hs-source-dirs: app
  build-depends:
    aihc-parser >=3.0 && <3.1,
    base >=4.19 && <5,
    optparse-applicative >=0.16 && <0.19,
    prettyprinter >=1.7 && <1.8,
    text >=2.1.2 && <2.2,

  ghc-options: -Wall
  default-language: GHC2021
