cabal-version: 3.8
name: aihc-parser-bench
version: 0.1.0.0
build-type: Simple
license: Unlicense
license-file: LICENSE
author: David Himmelstrup
maintainer: lemmih@gmail.com
category: Development
synopsis: Relative Stackage benchmarks for aihc-parser and aihc-cpp

library
  exposed-modules:
    Aihc.Parser.Bench.Benchmark
    Aihc.Parser.Bench.CLI
    Aihc.Parser.Bench.Coverage
    Aihc.Parser.Bench.Metrics
    Aihc.Parser.Bench.Parsers
    Aihc.Parser.Bench.Report
    Aihc.Parser.Bench.Run
    Aihc.Parser.Bench.Tarball

  hs-source-dirs: src
  build-depends:
    Cabal-syntax >=3.14 && <3.17,
    aeson >=2.0 && <2.3,
    aihc-cpp >=1.0 && <1.1,
    aihc-hackage,
    aihc-parser,
    async >=2.2 && <2.3,
    base >=4.16 && <5,
    bytestring >=0.10.8 && <0.13,
    containers >=0.5 && <0.9,
    cpphs >=1.20 && <1.21,
    deepseq >=1.4 && <1.6,
    directory >=1.2.3 && <1.5,
    filepath >=1.3.0.1 && <1.6,
    ghc-lib-parser >=9.14 && <9.15,
    haskell-src-exts >=1.23 && <1.24,
    http-client >=0.5 && <0.8,
    http-client-tls >=0.2 && <0.4,
    optparse-applicative >=0.16 && <0.19,
    process >=1.6 && <1.8,
    tar >=0.5 && <0.7,
    text >=1.2.3 && <2.2,
    time >=1.9 && <1.15,
    zlib >=0.5.4 && <0.8,

  default-extensions: OverloadedStrings
  ghc-options: -Wall
  default-language: GHC2021

executable aihc-parser-bench
  main-is: Main.hs
  hs-source-dirs: app
  build-depends:
    aihc-parser-bench,
    base >=4.16 && <5,

  ghc-options:
    -Wall
    -threaded
    -rtsopts
    -with-rtsopts=-N

  default-language: GHC2021

test-suite spec
  type: exitcode-stdio-1.0
  main-is: Spec.hs
  hs-source-dirs: test
  other-modules:
    Test.ParserBenchCoverage
    Test.ParserBenchReport

  build-depends:
    aihc-hackage,
    aihc-parser-bench,
    base >=4.16 && <5,
    tasty,
    tasty-hunit,

  ghc-options: -Wall
  default-language: GHC2021
